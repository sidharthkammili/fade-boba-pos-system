# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fade_boba
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_SSL=false

# Optional alternative for hosted PostgreSQL
# DATABASE_URL=postgresql://user:password@host:5432/database

# Express server
PORT=3001

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# Comma-separated staff accounts allowed to access cashier/manager views
APPROVED_STAFF_EMAILS=manager@example.com,cashier@example.com

# Optional contact email used by the translation service
TRANSLATE_CONTACT_EMAIL=
